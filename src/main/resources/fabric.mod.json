{
  "schemaVersion": 1,
  "id": "bingosplash",
  "version": "${version}",
  "name": "BingoSplash",
  "description": "Dynamic Island style HUD for Fabric.",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "cc.me0wo.bingosplash.BingoSplash",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "bingosplash.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "owo": "*"
  }
}
